    <path android:strokeColor="#FFB74D" android:strokeWidth="2.5" android:strokeLineCap="round" android:pathData="M64,65 L74,71"/>
    <!-- 골드 V (작음). -->
    <path android:strokeColor="#D6AD5B" android:strokeWidth="3" android:strokeLineJoin="round" android:strokeLineCap="round" android:pathData="M41,38 L48,54 L56,38"/>
    <!-- 오프화이트 V (큼). 우측 다리는 골드 V 우측 다리와 평행, 끝점은 골드 V 상단과 같은 높이. -->
